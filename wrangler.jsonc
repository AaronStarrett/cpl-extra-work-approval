{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpl-extra-work-approval",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEqYcsD85GcXvGY4",
    "RETENTION_DAYS": "90"
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "env": {
    "local": {
      "name": "cpl-extra-work-approval-local",
      "vars": {
        "ENVIRONMENT": "local",
        "ALLOW_TEST_PROTECTION": "true",
        "RETENTION_DAYS": "90",
        "CREATE_LIMIT_PER_HOUR": "100",
        "RATE_LIMIT_PER_MINUTE": "1000",
        "TURNSTILE_SITE_KEY": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cpl-extra-work-approval-local",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "database_id": "027399f9-7640-4fca-8518-db2ca8b6ccc0",
      "binding": "DB",
      "database_name": "cpl-extra-work-approval",
      "migrations_dir": "migrations"
    }
  ]
}
